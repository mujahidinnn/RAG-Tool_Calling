# Salin file ini ke .env.local lalu isi nilainya. JANGAN commit .env.local
# (sudah masuk .gitignore). Semua variabel hanya dibaca di server (lib/env.ts),
# tidak pernah dikirim ke browser. Nilai kosong dianggap belum di-set.

# --- Supabase (WAJIB) --------------------------------------------------------
# URL project: Supabase Dashboard → Project Settings → API.
SUPABASE_URL=https://your-project-ref.supabase.co
# Service role key (rahasia, bypass RLS) — hanya untuk server. Anon key tidak dipakai.
SUPABASE_SERVICE_ROLE_KEY=

# --- Gerbang demo (WAJIB) ----------------------------------------------------
# Passcode yang dibagikan manual ke pengguna demo. Pakai 12+ karakter acak.
DEMO_PASSCODE=

# --- Provider chat (opsional per provider) -----------------------------------
# Provider tanpa key tetap muncul di dropdown, tapi request-nya ditolak dengan
# error jelas (tidak ada fallback diam-diam ke provider lain).
ANTHROPIC_API_KEY=
# OPENAI_API_KEY juga WAJIB untuk embedding (upload & retrieval), apa pun provider chat-nya.
OPENAI_API_KEY=
# Pilihan awal dropdown di UI: anthropic | openai (default: anthropic).
DEFAULT_LLM_PROVIDER=anthropic

# --- Embedding (sengaja 1 provider, dimensi harus cocok dengan vector(1536)) --
# Saat ini hanya "openai" yang didukung.
EMBEDDING_PROVIDER=openai
# Harus ada di lib/llm/pricing.ts dan menghasilkan vector 1536 dimensi.
EMBEDDING_MODEL=text-embedding-3-small

# --- Budget harian global (opsional, default 2) --------------------------------
# Batas biaya LLM + embedding per hari (UTC) dalam USD, untuk semua sesi.
# Pakai titik sebagai desimal (0.5, bukan 0,5). Tiap panggilan LLM/embedding
# memesan biaya MAKSIMALNYA dulu (lalu dikoreksi ke biaya nyata): 1 pertanyaan
# chat memesan ±$0.05–0.08 di awal (+ ±$0.05 per ronde tool / ringkasan
# berikutnya). Budget di bawah ±$0.06 (mis. 0.01 untuk tes spec §10) menolak
# SEMUA pertanyaan dengan pesan limit harian; server mencatat peringatan.
# Upload juga memesan biaya embedding-nya (kecil: ±$0.003 per dokumen terbesar).
DAILY_BUDGET_USD=2

# --- IP klien untuk rate limit (opsional, default 0) ---------------------------
# Jumlah reverse proxy tepercaya di depan app yang MENAMBAHKAN IP klien ke
# X-Forwarded-For (mis. 1 untuk nginx dengan $proxy_add_x_forwarded_for).
# 0 = header IP tidak dipercaya, karena klien bisa memalsukannya (`next start`
# tanpa proxy meneruskan X-Forwarded-For dari klien apa adanya) — limiter
# per-IP dimatikan, limiter per sesi & global tetap jalan. Di Vercel tidak
# perlu diisi: header IP diisi ulang oleh platform (terdeteksi lewat env VERCEL).
TRUSTED_PROXY_HOPS=0
